# Hackathons Platform Environment Configuration
# Copy this file to .env and fill in the values

# ===========================================
# SUPABASE (SEPARATE PROJECT FOR HACKATHONS)
# ===========================================
HACKATHONS_SUPABASE_URL=https://your-hackathons-project.supabase.co
HACKATHONS_SUPABASE_ANON_KEY=eyJ...your-anon-key
HACKATHONS_SUPABASE_SERVICE_KEY=eyJ...your-service-key

# ===========================================
# SERVER
# ===========================================
PORT=3001
NODE_ENV=development

# ===========================================
# JWT
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your-cookie-secret-change-in-production

# ===========================================
# CORS
# ===========================================
CORS_ORIGIN=http://localhost:3001

# ===========================================
# GMAIL SMTP (FOR BULK/ADMIN EMAILS)
# ===========================================
GMAIL_SMTP_USER=your-hackathons-email@gmail.com
GMAIL_SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ===========================================
# EMAIL SETTINGS
# ===========================================
EMAIL_FROM_NAME=SR Coding Club Hackathons
EMAIL_FROM_ADDRESS=hackathons@srcodingclub.com
EMAIL_RATE_LIMIT=500
