{
    "version": 2,
    "name": "sr-coding-club",
    "buildCommand": null,
    "outputDirectory": ".",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://YOUR_RENDER_SERVICE_NAME.onrender.com/api/:path*"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                }
            ]
        }
    ]

}
